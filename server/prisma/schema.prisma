model WishlistItem {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userEmail, projectId])
  @@index([userEmail])
  @@index([projectId])
}

model ProjectLike {
  id        String   @id @default(uuid())
  userEmail String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userEmail, projectId])
  @@index([userEmail])
  @@index([projectId])
}

model NavMenu {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  icon        String?      @default("Layers")
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  submenus    NavSubmenu[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model NavSubmenu {
  id          String       @id @default(uuid())
  menuId      String
  menu        NavMenu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  services    Service[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([menuId, slug])
}

model Service {
  id             String      @id @default(uuid())
  title          String
  slug           String      @unique
  subtitle       String?
  description    String
  pricePerSqFt   Float       // e.g. 1850.0
  priceUnit      String      @default("per sq.ft")
  minAreaSqFt    Int?        @default(500)
  durationWeeks  Int?        @default(6)
  category       String      @default("Interior Design")
  imageUrl       String      @default("/assets/projects/project-patio.jpg")
  galleryImages  String[]    @default([])
  features       String[]    @default([])
  enableEnquiry  Boolean     @default(true)
  enableWhatsApp Boolean     @default(true)
  isFeatured     Boolean     @default(true)
  order          Int         @default(0)
  submenuId      String?
  submenu        NavSubmenu? @relation(fields: [submenuId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([category])
  @@index([pricePerSqFt])
}

model SocialMediaPost {
  id            String    @id @default(uuid())
  platform      String    // "Instagram", "Facebook", "Pinterest", "YouTube"
  postUrl       String?
  caption       String
  mediaUrl      String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)
  sentiment     String?   @default("POSITIVE") // "POSITIVE", "NEUTRAL", "INQUIRY", "NEGATIVE"
  topComment    String?
  postedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

model AiAnalysisLog {
  id             String   @id @default(uuid())
  modelName      String   @default("llama3.2:3b")
  ollamaEndpoint String   @default("http://localhost:11434")
  analysisType   String   // "SOCIAL_TRENDS", "EXECUTIVE_REPORT", "USER_BEHAVIOR", "AD_CAMPAIGN_COPY"
  prompt         String
  response       String   // Analysis generated by Ollama LLM
  metrics        String?  // JSON stringified stats
  createdAt      DateTime @default(now())
}

model AdCampaign {
  id               String    @id @default(uuid())
  name             String
  platform         String    @default("Instagram & Facebook") // "Instagram", "Facebook", "Instagram & Facebook", "WhatsApp Click-to-Chat"
  placement        String    @default("Instagram Reels & Feed")
  objective        String    @default("LEAD_GENERATION") // "LEAD_GENERATION", "WHATSAPP_MESSAGES", "WEBSITE_TRAFFIC", "BRAND_AWARENESS"
  status           String    @default("ACTIVE") // "ACTIVE", "PAUSED", "COMPLETED", "DRAFT"
  dailyBudget      Float     @default(1500)
  totalBudget      Float     @default(45000)
  spentAmount      Float     @default(12400)
  targetAudience   String    @default("Bengaluru Villa & Luxury Apartment Owners (28-58 yrs) — Rajajinagar, Sadashivanagar, Indiranagar, Whitefield")
  targetLocations  String    @default("Bengaluru, Karnataka (+25 km radius)")
  headline         String
  primaryText      String
  ctaText          String    @default("Send WhatsApp Message")
  destinationUrl   String    @default("https://wa.me/918921336363")
  mediaUrl         String    @default("/assets/projects/project-zen-courtyard.jpg")
  targetService    String?   @default("Luxury Interior Design (₹1,850/sq.ft)")
  impressions      Int       @default(18450)
  clicks           Int       @default(642)
  leadsCount       Int       @default(28)
  conversionsCount Int       @default(6)
  roas             Float     @default(4.8)
  aiOptimized      Boolean   @default(true)
  startDate        DateTime  @default(now())
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
