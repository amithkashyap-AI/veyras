datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  QUOTATION_SENT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String?
  phone              String?
  password           String?
  role               String         @default("USER") // ADMIN, MANAGER, ARCHITECT, EDITOR, USER
  title              String?        @default("Client")
  department         String?        @default("General")
  avatarUrl          String?
  bio                String?
  status             String         @default("ACTIVE") // ACTIVE, SUSPENDED
  permissions        String[]       @default([])
  twoFactorEnabled   Boolean        @default(true)
  otp                String?
  otpExpiry          DateTime?
  mustChangePassword Boolean        @default(true)
  hasChangedPassword Boolean        @default(false)
  lastLoginAt        DateTime?
  reviews            Review[]
  wishlists          WishlistItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  color       String    @default("blue") // blue, green, red, pink, orange
  description String?
  image       String?
  projects    Project[]
  createdAt   DateTime  @default(now())
}

model Project {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  tagline       String?
  description   String
  approxPrice   Float          // Approximate base cost
  priceUnit     String         @default("Total Project Estimate")
  areaSqFt      Int?
  timeline      String?
  materials     String?
  address       String
  city          String
  state         String?
  country       String         @default("India")
  lat           Float          @default(12.9716)
  lng           Float          @default(77.5946)
  isFeatured    Boolean        @default(false)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  images        ProjectImage[]
  enquiries     Enquiry[]
  reviews       Review[]
  wishlists     WishlistItem[]
  likes         ProjectLike[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([city])
  @@index([approxPrice])
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  userEmail String
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Enquiry {
  id             String        @id @default(uuid())
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientName     String
  clientEmail    String
  clientPhone    String
  siteAddress    String
  city           String
  propertyType   String        @default("Residential Villa")
  areaSqFt       Int?
  approxBudget   String?
  preferredStyle String?
  message        String
  status         EnquiryStatus @default(NEW)
  internalNotes  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CompanySetting {
  id           String   @id @default("default")
  companyName  String   @default("Veyra's Construction and Interiors")
  tagline      String   @default("Building Spaces • Creating Lifestyles")
  phone        String   @default("089213 36363")
  whatsapp     String   @default("089213 36363")
  email        String   @default("contact@veyrasinteriors.com")
  address      String   @default("#98, 1st Main, 4th Cross, Manjunatha Nagar, Rajajinagar, Bengaluru - 560010")
  city         String   @default("Bengaluru")
  workingHours String   @default("Mon - Sat: 9:00 AM - 7:30 PM")
  logoUrl      String   @default("/assets/branding/veyras-logo.jpg")
  updatedAt    DateTime @updatedAt
}

